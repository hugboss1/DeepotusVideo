    "en": "The banner says who you are working for; Client sheet opens consents, posts awaiting approval and the log."
   },
   "avant": [
    {
     "js": "fetch('/api/espaces',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nom:'Boulangerie Démo',couleur:'#c2410c',type:'client'})}).then(function(r){return r.json()}).then(function(j){var id=j.espace.id;return fetch('/api/espaces/'+id+'/client',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({societe:'Boulangerie Démo SARL',contact:{nom:'Camille Exemple',email:'contact@exemple.test',whatsapp:''},pays:'FR',langue:'fr',mode_publication:'valide_par_client'})}).then(function(){return fetch('/api/espaces/'+id+'/activate',{method:'POST'})})})"
