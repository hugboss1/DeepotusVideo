{
 "base": "http://127.0.0.1:8799",
 "preparation": "Backend de preuve t259 (serve_t259.py : worktree photolab-m10-cloture, moteur photocraft 0.10.0 de l'installation, données jetables, aucune clé) ; l'image demo-paysage.png est posée dans sa Bibliothèque (dessinée par un script Pillow : ciel, soleil, collines, balle, tache).",
 "scenes": [
  {
   "scene": "photolab/actions",
   "titre": {"fr": "Enregistrer une action", "en": "Record an action"},
   "legende": {"fr": "Panneau Actions : Nouvelle action, puis chaque geste fait sur l'image devient une étape, rejouable sur d'autres images.",
               "en": "Actions panel: New action, then every gesture you make on the image becomes a step you can replay on other images."},
   "url": "/photolab/",
   "avant": [
    {"js": "fetch('/api/photolab/espaces',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({version:1,actif:'essentiel',verrouille:false,modifs:{},perso:[]})}).then(r=>r.json())"},
    {"js": "fetch('/api/photolab/executer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({command:'file.closeAll',params:{}})}).then(r=>r.json())"},
    {"js": "fetch('/api/photolab/actions').then(r=>r.json()).then(async j=>{for(const a of (j.actions||[])) await fetch('/api/photolab/executer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({command:'actions.delete',params:{action:a.name}})});})", "attente": 800},
    {"aller": "/photolab/"},
    {"attente": 1500},
    {"js": "window.PL.ouvrirImage('demo-paysage.png')", "attente": 4500},
    {"clic": "css:.onglet[data-onglet=\"actions\"]", "apres": 1200}
   ],
   "captures": [
    {"nom": "panneau"},
    {"nom": "dialogue", "etapes": [{"clic": {"fr": "css:button[title=\"Nouvelle action\"]", "en": "css:button[title=\"New action\"]"}, "apres": 1000}]},
    {"nom": "etape", "etapes": [
      {"clic": {"fr": "texte:Commencer l'enregistrement", "en": "texte:Begin recording"}, "apres": 1200},
      {"js": "window.PL.executer('image.adjustments.invert',{})", "attente": 2500},
      {"clic": {"fr": "css:button[title=\"Arrêter la lecture ou l'enregistrement\"]", "en": "css:button[title=\"Stop playing or recording\"]"}, "apres": 2000}
    ]}
   ],
   "temps": [
    {"capture": 0, "duree": 2.4, "curseur": {"fr": "css:button[title=\"Nouvelle action\"]", "en": "css:button[title=\"New action\"]"}, "clic": true,
     "bulle": {"fr": "Une action neuve", "en": "A new action"}},
    {"capture": 1, "duree": 2.6, "curseur": {"fr": "texte:Commencer l'enregistrement", "en": "texte:Begin recording"}, "clic": true,
     "bulle": {"fr": "Nommez-la, puis enregistrez", "en": "Name it, then record"}},
    {"capture": 2, "duree": 3.0, "surligne": {"fr": "contient:Inverser", "en": "contient:Invert"},
     "bulle": {"fr": "Chaque geste devient une étape", "en": "Every gesture becomes a step"}}
   ]
  }
 ]
}
