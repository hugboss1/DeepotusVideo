       "js": "(async()=>{const g=document.querySelector('#peintreOut canvas');const r=g.getBoundingClientRect();const cw=r.width/12,ch=r.height/8;const ev=(t,x,y)=>g.dispatchEvent(new PointerEvent(t,{bubbles:true,clientX:r.x+x*cw+cw/2,clientY:r.y+y*ch+ch/2,button:0,buttons:t==='pointerup'?0:1,pointerId:1,isPrimary:true}));const p=[];for(let y=2;y<=5;y++)for(let x=3;x<=8;x++)p.push([x,y]);p.push([9,3],[9,4],[2,4],[5,6],[6,6],[6,1]);for(const [x,y] of p){ev('pointerdown',x,y);ev('pointerup',x,y);await new Promise(r=>setTimeout(r,120));}})()",
