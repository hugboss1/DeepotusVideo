{
 "base": "http://127.0.0.1:8827",
 "scenes": [
  {
   "scene": "capture-live/studio",
   "taille": [
    1208,
    800
   ],
   "titre": {
    "fr": "Meubler un décor du studio virtuel",
    "en": "Furnish a virtual studio set"
   },
   "legende": {
    "fr": "Voir les décors, personnaliser une copie, puis l'onglet Catalogue : un vrai produit se télécharge et se pose à sa taille.",
    "en": "Browse sets, customise a copy, then the Catalogue tab: a real product downloads and lands at its true size."
   },
   "avant": [
    {
     "js": "try{localStorage.setItem('dz_studiov_qualite','haute')}catch(e){}; fetch('/api/studiov').then(function(r){return r.json()}).then(function(j){return Promise.all((j.decors||[]).map(function(x){return fetch('/api/studiov/'+x.id,{method:'DELETE'})}))}).then(function(){return fetch('/api/studiov/choix',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({decor_id:''})})}).then(function(){return 0})"
    },
    {
     "attente": 800
    }
   ],
   "captures": [
    {
     "nom": "decors",
     "etapes": [
      {
       "js": "window.__dzStudiov.ouvrirApercu({decor:'livre-loft'}); 0"
      },
      {
       "attente": 6000
      }
     ]
    },
    {
     "nom": "catalogue",
     "etapes": [
      {
       "clic": "css:[data-dz-studiov-personnaliser]",
       "apres": 5000
      },
      {
       "clic": "css:[data-dz-studiov-onglet=catalogue]",
       "apres": 2500
      },
      {
       "js": "var b=document.querySelector('[data-dz-studiov-cat-charger]'); if(b) b.click(); 0"
      },
      {
       "attente": 8000
      },
      {
       "js": "var c=document.querySelector('[data-dz-studiov-cat-filtre]'); c.value='floor lamp'; c.dispatchEvent(new Event('change')); 0"
      },
      {
       "attente": 6000
      },
      {
       "js": "document.querySelectorAll('[data-dz-studiov-cat-produit]')[(typeof window.dzLang==='function'&&window.dzLang()==='en')?2:1].click(); 0"
      },
      {
       "attente": 1500
      }
     ]
    },
    {
     "nom": "pose",
     "etapes": [
      {
       "js": "document.querySelector('[data-dz-studiov-cat-poser]').click(); 0"
      },
      {
       "attente": 12000
      }
     ]
    }
   ],
   "temps": [
    {
     "capture": 0,
     "duree": 2.8,
     "surligne": "css:[data-dz-studiov-personnaliser]",
     "bulle": {
      "fr": "Un décor livré se personnalise en copie",
      "en": "A built-in set is customised as a copy"
     }
    },
    {
     "capture": 1,
     "duree": 3.2,
     "curseur": "css:[data-dz-studiov-cat-poser]",
     "clic": true,
     "bulle": {
      "fr": "Catalogue : de vrais produits, à leur taille",
      "en": "Catalogue: real products, at their true size"
     }
    },
    {
     "capture": 2,
     "duree": 3.0,
     "bulle": {
      "fr": "Le produit est posé ; un luminaire éclaire",
      "en": "The product is placed; a lamp gives light"
     }
    }
   ]
  }
 ]
}
