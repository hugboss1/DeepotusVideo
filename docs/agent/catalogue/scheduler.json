    {"id": "scheduler.post.supprimer", "ecran": "scheduler", "cadre": null, "type": "bouton", "libelle": {"fr": "", "en": ""}, "infobulle": {"fr": "Supprimer", "en": "Delete"}, "icone": null, "role": {"fr": "Supprime définitivement le post du calendrier, après une confirmation (pas de corbeille). Le rendu attaché reste dans la Bibliothèque.", "en": "Permanently deletes the post from the calendar after a confirmation (there is no trash). The attached render stays in the Library."}, "synonymes": {"fr": ["effacer", "retirer le post", "poubelle", "annuler la publication"], "en": ["remove", "erase", "trash", "cancel post"]}, "guide": "planificateur", "localisateur": null, "sources": ["i18n:scheduler.post.supprimer"], "empreinte": "c67f74118a64", "etat": "redige"},
    {"id": "scheduler.routage.envoyer", "ecran": "scheduler", "cadre": null, "type": "bouton", "libelle": {"fr": "Envoyer maintenant", "en": "Send now"}, "infobulle": null, "icone": "dz-action-publier", "role": {"fr": "Publie le post tout de suite sur ses canaux connectés (Telegram, X, YouTube, Instagram, TikTok), après une confirmation qui nomme les canaux ; les canaux sans connexion passent « prêt » pour un envoi manuel. Action publique, quotas vérifiés.", "en": "Publishes the post right away on its connected channels (Telegram, X, YouTube, Instagram, TikTok), after a confirmation naming the channels; unconnected channels are marked ready for manual sending. Public action, quotas checked."}, "synonymes": {"fr": ["publier", "poster maintenant", "envoyer tout de suite", "diffuser"], "en": ["publish", "post now", "send immediately", "broadcast"]}, "guide": "planificateur", "localisateur": null, "sources": ["i18n:scheduler.routage.envoyer"], "empreinte": "b20fc323ffe4", "etat": "redige"},
