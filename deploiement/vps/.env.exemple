# t531 — copier en « .env » (même dossier). Aucune clé de fournisseur ici : elles se saisissent dans
# Réglages › Clés de l'app et dorment dans le coffre, sur le volume /srv/deepotus/data.

# Le nom public (enregistrement A vers l'IP du VPS) : Caddy le sert, le backend l'accepte comme origine (t530).
DEEPOTUS_HOSTNAME=studio.deepotus.tech

# Coffre retenu par fichier de clé (t532) : hors du volume de données sauvegardé.
DEEPOTUS_COFFRE_CLE_FICHIER=/secrets/coffre.cle

# Langue de l'interface au premier démarrage.
UI_LANG=fr
