# Modèle de /srv/deepotus/secrets/api.env (API du site, service « api » du Compose). NOMS seulement, aucune valeur ici.
# Sur le VPS : chmod 600, propriétaire root. Copie de chaque valeur dans le gestionnaire de mots de passe ; jamais dans git.
# Les autres variables (NODE_ENV, API_URL, SITE_URL, chemins) sont dans docker-compose.yml.

# Clé HMAC (défi anti-robot, index des adresses, tickets de téléchargement). openssl rand -hex 32. Ne JAMAIS la changer.
ATTENTE_SECRET=
# Clé AES-256-GCM des adresses (liste d'attente et commandes). openssl rand -hex 32. La perdre rend tout illisible.
ATTENTE_CLE_CHIFFREMENT=

# Brevo (palier gratuit, 300 e-mails/jour) : clé d'API SMTP restreinte à l'IP du VPS ; expéditeur sur deepotus.tech authentifié.
ENVOI=brevo
BREVO_API_KEY=
ATTENTE_EXPEDITEUR=contact@deepotus.tech

# Adresse interne qui reçoit devis, rendez-vous et rétractations (POST /api/demande).
DEMANDES_DESTINATAIRE=contact@deepotus.tech

# Mentions au bas de chaque e-mail texte (recopiées de site-fusion/src/data/editeur.ts ; prénom + initiale, jamais le nom complet).
EDITEUR_DENOMINATION=Deepotus, édité par Olivier S.
EDITEUR_FORME_JURIDIQUE=entrepreneur individuel
EDITEUR_FORME_JURIDIQUE_EN=sole trader
EDITEUR_FORME_JURIDIQUE_ES=autónomo
EDITEUR_ADRESSE_POSTALE=Calle San Vicente 2, 03769 El Ràfol d'Almúnia (Alicante), Espagne
EDITEUR_IMMATRICULATION=

# Conservation de la liste d'attente : N mois après le lancement (EDITEUR.donnees.conservationListe), date du lancement.
ATTENTE_CONSERVATION_MOIS=12
ATTENTE_LANCEMENT=

# Stripe : secret de signature du point de terminaison https://api.deepotus.tech/api/stripe/webhook (whsec_…), un par mode.
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_TEST=

# Installeur servi par les liens signés (déposé dans /srv/deepotus/telechargements). Absent : aucune livraison ne part.
TELECHARGEMENT_FICHIER=/telechargements/VideoGen-Setup.exe
# Livraison de la prévente (les commandes en mode test Stripe sont livrées tout de suite).
LIVRAISON_LE=2026-12-08T09:00:00+01:00
